<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created by hand for the MOSEL golden cases: 0*1*.--><structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="zeros">
			<x>100.0</x>
			<y>100.0</y>
			<initial/>
			<final/>
		</state>
		<state id="1" name="ones">
			<x>220.0</x>
			<y>100.0</y>
			<final/>
		</state>
		<state id="2" name="dead">
			<x>340.0</x>
			<y>100.0</y>
		</state>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>0</read>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>1</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>1</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>0</read>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>0</read>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>1</read>
		</transition>
	</automaton>
</structure>
